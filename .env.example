# Public values. Safe in the browser only because RLS is enforced.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose these through browser JavaScript
# or a public config endpoint. Set them in the Vercel dashboard.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=

# Transactional email (Resend). Without RESEND_API_KEY the API still stores
# submissions, it just skips sending mail.
RESEND_API_KEY=
EMAIL_FROM="Crystalina <noreply@crystalina.org>"
CONTACT_INBOX=info@crystalina.org

# Public keys/URLs, safe to expose only when their provider permits it.
TURNSTILE_SITE_KEY=
PUBLIC_SITE_URL=https://crystalina.org
