# Public values may be used by the browser only after RLS has been applied.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose these through browser JavaScript or a public config endpoint.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TURNSTILE_SECRET_KEY=

# Public keys/URLs, safe to expose only when their provider permits it.
TURNSTILE_SITE_KEY=
PUBLIC_SITE_URL=https://crystalina.org
